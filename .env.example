# Copy values into Vercel environment settings; never commit real values.
# Browser build inputs (public): development/Preview should use the development project.
# For Production, both Supabase URLs must use hgdqarcdfycdesavwrvq.
# Vercel supplies VERCEL_ENV automatically; no extra project-ref variable is needed.
WEB_SUPABASE_URL=https://ehyqvyglirirktfmdezq.supabase.co
WEB_SUPABASE_ANON_KEY=replace-with-development-sb_publishable-key

# Vercel Function runtime (secret except SUPABASE_URL/GMAIL_ADDRESS).
SUPABASE_URL=https://ehyqvyglirirktfmdezq.supabase.co
# Server only: use the project's sb_secret_ key. The existing legacy
# service_role JWT remains supported during the controlled Production rotation.
SUPABASE_SERVICE_ROLE_KEY=replace-with-development-sb_secret-key
GMAIL_ADDRESS=replace-with-sending-address
GMAIL_APP_PASSWORD=replace-with-server-only-app-password

# Keep the email-change endpoint disabled except for a controlled change.
ADMIN_EMAIL_CHANGE_ENABLED=0
ADMIN_EMAIL_CHANGE_PROJECT_REF=ehyqvyglirirktfmdezq
